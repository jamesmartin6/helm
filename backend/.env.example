# Copy to .env and adjust as needed. All variables are HELM_-prefixed and
# optional -- see app/config.py for defaults.

# SQLAlchemy async URL. Defaults to a local SQLite file if unset.
# HELM_DATABASE_URL=postgresql+asyncpg://helm:helm@localhost:5432/helm

# TCP address of the firmware's UART bridge (see qemu_runner.py /
# docker-compose.yml for how this gets started).
# HELM_FIRMWARE_HOST=127.0.0.1
# HELM_FIRMWARE_PORT=5678
